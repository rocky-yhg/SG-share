#!/bin/bash
#PBS -N table3_globem
#PBS -q v100q
#PBS -P 20260209
#PBS -l select=1:mem=64G:ncpus=8:ngpus=1:host=aimc-gn1
#PBS -l walltime=24:00:00
#PBS -j oe

set -euo pipefail

PROJECT=/home/users/zhu_sun/zhuoxuan/Online_Learning_for_Mental_Health_Monitoring_with_Passive_Sensing_Data/code/SG-share
PYTHON=/scratch/zhu_sun/zhuoxuan/envs/verl_env/bin/python
OUTPUT=results/table3_metrics_20260722/globem

cd "$PROJECT"
mkdir -p "$OUTPUT"
export PYTHONPATH="$PROJECT"
export OMP_NUM_THREADS=8
export MKL_NUM_THREADS=8

hostname
echo "CUDA_VISIBLE_DEVICES=${CUDA_VISIBLE_DEVICES:-}"
nvidia-smi --query-gpu=index,name,memory.total --format=csv

"$PYTHON" process/run_table3_experiments.py \
  --dataset globem \
  --data data/processed/globem_full.csv \
  --output "$OUTPUT" \
  --seeds 42,43,44 \
  --methods hbp,koil,oli2ds,olifl,ecap \
  --device cuda \
  --torch-threads 8 \
  --resume 2>&1 | tee "$OUTPUT/run.log"
