__pycache__/
*.py[cod]
.pytest_cache/
.venv/
.DS_Store
._*
.tmp/
=
.env
.env.*
!.env.example
*.log
*.out
*.err
*.pem
*.key
/AGENTS.md

# Dataset payloads are obtained from their official sources. Never publish
# participant-level raw or processed records from this repository.
data/raw/*
data/processed/*
data/processed.zip
data/releases/
!data/raw/.gitkeep
!data/processed/.gitkeep
data/audit/**/*.csv*
data/audit/**/*.arff

# Third-party repositories are fetched at pinned commits for source audits.
# Keep their own histories and licenses separate from SG-Share.
vendor/

# Generated predictions, checkpoints, and experiment reports are local output.
results/*
!results/.gitkeep
!results/manuscript_audit_20260727/
!results/manuscript_audit_20260727/**
*.ckpt
*.pt
*.pth
*.npz
